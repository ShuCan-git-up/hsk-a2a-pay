# ---- HashKey Chain ---------------------------------------------------------
# Testnet (default)
HSK_RPC_URL=https://testnet.hsk.xyz
HSK_CHAIN_ID=133
HSK_EXPLORER_URL=https://testnet-explorer.hskchain.net
HSP_NETWORK=hashkey-testnet
TOKEN_ADDRESS=0x8FE3cB719Ee4410E236Cd6b72ab1fCDC06eF53c6   # USDC (EIP-3009) on HashKey testnet, per HSP docs
# Mainnet (for the final demo): HSK_RPC_URL=https://mainnet.hsk.xyz HSK_CHAIN_ID=177
#   HSK_EXPLORER_URL=https://hashkey.blockscout.com HSP_NETWORK=hashkey
#   TOKEN_ADDRESS=0x054ed45810DbBAb8B27668922D110669c9D88D0a (USDC, EIP-3009)

# A2ASettlement contract (blank = on-chain anchoring off)
CONTRACT_ADDRESS=
# Operator key that sends publishTerms / recordHspSettlement. Needs a little HSK for gas.
OPERATOR_PRIVATE_KEY=

# ---- HSP (HashKey Settlement Platform) ---------------------------------------
# mock = local simulation of the 8 MCP tools; mcp = HSP Agentic Payment (needs your server IP allow-listed by HSP)
HSP_MODE=mock
HSP_MCP_URL=https://mcp-qa.hashkeymerchant.com/
# Team attribution name: use EXACTLY your DoraHacks team/BUIDL name
HSP_MERCHANT_NAME=HSK A2A Pay
HSP_POLL_SECONDS=15
# Optional: own HSP merchant account for the REST API (not needed for the agentic flow)
HSP_APP_KEY=
HSP_APP_SECRET=
HSP_MERCHANT_PRIVATE_KEY_PEM=

# ---- Receiving agent ---------------------------------------------------------
RECEIVER_SIGNING_PRIVATE_KEY=
RECEIVER_PAY_TO=
RECEIVER_PRICE_USD=0.10
PUBLIC_BASE_URL=

# ---- Paying agent ------------------------------------------------------------
# Payer wallet that signs the EIP-712 authorization. In mcp mode it must hold the test USDC above.
PAYER_PRIVATE_KEY=
PAYER_MAX_PER_PAYMENT_USD=1.00
PAYER_DAILY_CAP_USD=5.00
PAYER_ALLOWED_PAY_TO=
PAYER_AUTO_APPROVE=false
RECEIVER_AGENT_URL=
